# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnpm-store/
/.gradle-cache/
/.android-home/
.atlas-tools/
*.tsbuildinfo
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
.dev.vars

# Build archives (regenerated by the deploy step, never source)
goocart-site.tar.gz
.openai/goocart-site.tar.gz

# --- Customer app (Expo) secrets --------------------------------------------
# The customer app is part of this monorepo, but its signing key, signing
# passwords and machine-local paths must never be committed. Losing the
# keystore means you can never update an app already on the Play Store.
# (Still named mobile/ below too: its android/ folder hasn't been moved to
# customer/ yet — Android Studio had it open during the customer/ rename.)
customer/.env
customer/android/local.properties
customer/android/gradle.properties
customer/android/app/*.keystore
customer/**/*.keystore
customer/**/*.jks
mobile/.env
# The whole tree, not just the secrets: this is generated `expo prebuild`
# output, not source — same reason it's blanket-ignored under customer/.expo
# and customer/android/ etc via customer/.gitignore. It has no .gitignore of
# its own to fall back on since customer/'s inherited it in the rename.
mobile/android/

# --- Delivery Partner app (Expo) secrets -----------------------------------
partner/.env
partner/android/local.properties
partner/android/gradle.properties
partner/android/app/*.keystore
partner/**/*.keystore
partner/**/*.jks

# --- Vendor app (Expo) secrets ----------------------------------------------
vendor/.env
vendor/android/local.properties
vendor/android/gradle.properties
vendor/android/app/*.keystore
vendor/**/*.keystore
vendor/**/*.jks

# Machine-local IDE state
customer/.idea/
mobile/.idea/
partner/.idea/
vendor/.idea/
.idea/

# --- Server secrets --------------------------------------------------------
# MongoDB connection strings embed the database password. Never commit these.
server/.env
server/.env.*
!server/.env.example
server/dist/
server/node_modules/
