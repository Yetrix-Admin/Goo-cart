{
  "expo": {
    "name": "Goocart Delivery Partner",
    "slug": "goocart-delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "goocartdelivery",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAFAFA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goocart.delivery",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Goocart Delivery Partner shares your live location with the customer and admin while you have an active delivery, so they can track your progress."
      }
    },
    "android": {
      "package": "com.goocart.delivery",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FF6B35",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF6B35",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Goocart Delivery Partner shares your live location with the customer and admin while you have an active delivery."
        }
      ],
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
