# Copy to .env for production Android builds.
EXPO_PUBLIC_API_URL=https://goo-cart.onrender.com

# Customer mobile Maps keys are public client keys, but they must still be
# restricted in Google Cloud Console before any release build:
# - Android key: restrict to package com.goocart.customer + release SHA-1
# - iOS key: restrict to bundle id com.goocart.customer
# Enable only the Maps SDK/API surfaces the app actually uses.
GOOCART_ANDROID_GOOGLE_MAPS_API_KEY=REPLACE_WITH_RESTRICTED_ANDROID_MAPS_KEY
GOOCART_IOS_GOOGLE_MAPS_API_KEY=REPLACE_WITH_RESTRICTED_IOS_MAPS_KEY
