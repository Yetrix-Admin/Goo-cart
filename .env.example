# Copy to .env.local for local dev. When deploying to Vercel, set the same
# variable in the Vercel project's environment variables instead — this file
# is never read in production.
#
# Backend the Admin web app proxies /api/* to (see app/api/[...path]/route.ts).
GOOCART_API_URL=https://goo-cart.onrender.com

# Optional backend automation tuning. These are safe defaults if omitted.
DELIVERY_OFFER_TIMEOUT_SECONDS=30
DELIVERY_INITIAL_RADIUS_KM=3
DELIVERY_MAX_RADIUS_KM=12
DELIVERY_RADIUS_STEP_KM=3
DELIVERY_MAX_OFFER_ATTEMPTS=3
DISPATCH_AVERAGE_CITY_SPEED_KMPH=22
DISPATCH_TARGET_ARRIVAL_BUFFER_MINUTES=3
