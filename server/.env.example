# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Connection string WITHOUT a database in the path; MONGODB_DB selects it.
# Keeping them separate means a shared cluster's other databases are untouched.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=goocart

PORT=3001

# Reserved for stateless tokens; sessions are currently opaque random values.
JWT_SECRET=<generate-a-long-random-string>

# Gmail API over HTTPS (not SMTP — cloud hosts commonly block outbound SMTP
# ports). Without these, OTP codes fall back to the server log and the API
# honestly reports that the code was not delivered.
# GMAIL_USER is the sending Gmail address. GMAIL_CLIENT_ID/GMAIL_CLIENT_SECRET
# identify an OAuth app (Google Cloud Console > APIs & Services >
# Credentials). GMAIL_REFRESH_TOKEN is a one-time consent grant for that
# mailbox (via https://developers.google.com/oauthplayground, scope
# https://www.googleapis.com/auth/gmail.send). None of these are the
# account's real password.
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Browser origins allowed to call this API. Empty = allow all (dev only).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

ADMIN_USER_EMAILS=
VENDOR_USER_EMAILS=
PARTNER_USER_EMAILS=
